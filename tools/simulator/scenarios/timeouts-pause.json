{
  "name": "timeouts-pause",
  "description": "I check pause-safe exits, an exact acceptance timeout, and a permissionless proposal timeout.",
  "steps": [
    { "type": "pause", "caller": "pauser", "paused": true },
    {
      "type": "create",
      "id": "cli-paused",
      "nonce": "cli-nonce-paused",
      "caller": "challenger",
      "challenger": "challenger",
      "challengerSide": "A",
      "stake": 100,
      "now": 300,
      "acceptanceDeadline": 310,
      "observationTime": 320,
      "sourceCorrectionCutoff": 325,
      "proposalDeadline": 350,
      "disputeWindow": 10,
      "arbitrationWindow": 20,
      "timeoutVoidAt": 380,
      "expect": { "ok": false, "error": "ContractPaused" }
    },
    { "type": "pause", "caller": "pauser", "paused": false },
    {
      "type": "create",
      "id": "cli-open-expiry",
      "nonce": "cli-nonce-open-expiry",
      "caller": "challenger",
      "challenger": "challenger",
      "challengerSide": "A",
      "stake": 100,
      "now": 300,
      "acceptanceDeadline": 310,
      "observationTime": 320,
      "sourceCorrectionCutoff": 325,
      "proposalDeadline": 350,
      "disputeWindow": 10,
      "arbitrationWindow": 20,
      "timeoutVoidAt": 380
    },
    { "type": "expire", "id": "cli-open-expiry", "now": 310, "expect": { "state": "EXPIRED" } },
    { "type": "refund", "id": "cli-open-expiry", "caller": "challenger" },
    {
      "type": "create",
      "id": "cli-proposal-timeout",
      "nonce": "cli-nonce-proposal-timeout",
      "caller": "challenger",
      "challenger": "challenger",
      "challengerSide": "B",
      "stake": 100,
      "now": 400,
      "acceptanceDeadline": 410,
      "observationTime": 420,
      "sourceCorrectionCutoff": 425,
      "proposalDeadline": 450,
      "disputeWindow": 10,
      "arbitrationWindow": 20,
      "timeoutVoidAt": 480
    },
    {
      "type": "accept",
      "id": "cli-proposal-timeout",
      "caller": "acceptor-a",
      "acceptor": "acceptor-a",
      "permitNonce": 0,
      "permitValid": true,
      "expiresAt": 409,
      "now": 401
    },
    { "type": "pause", "caller": "pauser", "paused": true },
    {
      "type": "propose",
      "id": "cli-proposal-timeout",
      "caller": "resolver",
      "outcome": "A",
      "evidenceHash": "proposal-paused",
      "now": 420,
      "expect": { "ok": false, "error": "ContractPaused", "state": "ACTIVE" }
    },
    { "type": "voidUnproposed", "id": "cli-proposal-timeout", "now": 450, "expect": { "state": "VOID" } },
    { "type": "refund", "id": "cli-proposal-timeout", "caller": "challenger" },
    { "type": "refund", "id": "cli-proposal-timeout", "caller": "acceptor-a" }
  ],
  "finalOutstanding": 0,
  "finalStates": { "cli-open-expiry": "EXPIRED", "cli-proposal-timeout": "VOID" }
}
